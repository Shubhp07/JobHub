# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=admin

# JWT Configuration
JWT_SECRET=your_jwt_secret_min_32_characters

# Application URLs
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
OAUTH2_REDIRECT_URI=http://localhost:5000/login/oauth2/code/google

# Mail Configuration (SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# AWS S3 Configuration
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=jobhub-bucket

# RapidAPI Configuration
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=active-jobs-db.p.rapidapi.com
RAPIDAPI_URL=https://active-jobs-db.p.rapidapi.com/active-ats-6m?description_type=text

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

